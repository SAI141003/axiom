# AXIOM 2.0 — keys. Copy to .env (the installer does this) and fill in.
# Easiest: open http://localhost:3300/settings and paste keys there; it writes
# the right files for you. Never commit .env.

AXIOM_EDITION=stocks            # stocks / ETF / options edition (leave as is)

# ── AI (at least one) ─────────────────────────────────────────────
# Groq: free, fastest — https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM: free tier — https://build.nvidia.com  (the Council's 72-agent swarm uses it)
NVIDIA_API_KEY=
NVIDIA_API_KEY_JARVIS=          # optional: a second NVIDIA key just for AXIOM's voice/chat
OPENAI_API_KEY=                 # optional: AXIOM's second opinion
CEREBRAS_API_KEY=               # optional fallback
ANTHROPIC_API_KEY=              # optional

# ── Alerts to your phone ──────────────────────────────────────────
# Install the free "ntfy" app, subscribe to a private topic name, put it here.
NTFY_TOPIC=

# ── Optional data ─────────────────────────────────────────────────
FMP_API_KEY=                    # Financial Modeling Prep: company valuations on the AI desk
