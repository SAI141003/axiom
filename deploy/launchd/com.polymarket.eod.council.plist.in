<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.polymarket.eod.council</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/.venv/bin/python</string>
    <string>__ROOT__/dryrun/eod_council.py</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StandardOutPath</key><string>__ROOT__/logs/eod_council.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/eod_council.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>16</integer>
    <key>Minute</key><integer>35</integer>
  </dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
