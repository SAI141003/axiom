<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.polymarket.dryrun.stocksbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/.venv/bin/python</string>
    <string>__ROOT__/dryrun/stocks_bot_daemon.py</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/logs/stocksbot.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/stocksbot.log</string>
</dict>
</plist>
