# ── Polymarket live account (set via /settings UI) ────────────────────────────
POLYMARKET_PRIVATE_KEY=       # wallet private key (Settings→Export on polymarket.com)
POLYMARKET_FUNDER=            # your Polymarket proxy/deposit address (0x...)
POLYMARKET_SIGNATURE_TYPE=1   # 1=email/Magic proxy, 0=EOA/MetaMask, 2=browser-wallet
# ── Trading mode (MANUAL two-step to go live) ─────────────────────────────────
DRY_RUN=true                  # true=no real orders. Flip to false ONLY when a strategy is ROBUST.
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=150
# ── Micro-live risk stack (edit at /live-account) ─────────────────────────────
LIVE_MICRO_USD=1              # stake per live order (hard ceiling $5)
LIVE_DAILY_CAP_USD=10
LIVE_DAILY_PROFIT_TARGET=5    # auto-stop after +$X profit (anti-overtrade)
LIVE_STOP_LOSS_USD=5          # auto-stop after -$X loss
# ── Per-bot master switches (edit at /settings) ───────────────────────────────
BOT_CRYPTO_ENABLED=true
BOT_ORACLELAG_ENABLED=true
BOT_WEATHER_ENABLED=true
BOT_KRONOS1H_ENABLED=true
BOT_PREMARKET_ENABLED=true
BOT_OPTIONS_ENABLED=true
# ── LLM (also in frontend/.env.local) ─────────────────────────────────────────
GROQ_API_KEY=                 # fast, free: console.groq.com  (primary)
NVIDIA_API_KEY=               # fallback
HF_TOKEN=                     # HuggingFace, for Kronos weight downloads
# ── Infra ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://trading:trading@localhost:5432/polymarket_hft

# pump.fun smart money — optional; a PumpPortal key funded with 0.02 SOL unlocks buyer-level tracking
PUMPPORTAL_API_KEY=

# JARVIS second brain — optional; GPT-6 Astra or any OpenAI-compatible model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
NVIDIA_API_KEY_JARVIS=   # optional: a dedicated NIM key for JARVIS (falls back to NVIDIA_API_KEY)
NVIDIA_MODEL_JARVIS=nvidia/nemotron-3-super-120b-a12b   # JARVIS brain (fast, tool-calling)
NVIDIA_MODEL_JARVIS_DEEP=nvidia/nemotron-3-ultra-550b-a55b   # JARVIS second opinion (slow, strongest)
MISTRAL_API_KEY=   # optional fast lane for JARVIS
SILICONFLOW_API_KEY=   # optional fast lane for JARVIS
ZHIPU_API_KEY=   # optional fast lane for JARVIS
META_API_KEY=   # Meta Model API (Muse Spark) — deep lane; $20 credit then paid

# ── Jev (TypeSafe AI) — optional typed-judgment model, ~100 ms, $0.042 per million input tokens, no free tier ──
# With a key the crypto 5-min bot asks Jev "up in 5 minutes?" on every window as a SHADOW judge
# (frozen before the outcome, Brier-scored at resolve — signals/jev.py, /api/jev) and AXIOM gains typed_judgment.
TYPESAFE_AI_API_KEY=
JEV_MODEL=jev-latest

# ── Agent402 toolbox (optional keys it can use; it runs keyless otherwise) ──
# git clone https://github.com/MikeyPetrillo/Agent402 .study/agent402 && (cd .study/agent402 && npm install)
# FREE_MODE=true PORT=3402 node .study/agent402/src/server.js   (AXIOM finds it at AGENT402_URL, default http://127.0.0.1:3402)
FRED_API_KEY=            # macro series (free at fred.stlouisfed.org)
COINGECKO_API_KEY=       # higher CoinGecko limits (free key)
BRAVE_API_KEY=           # web search tool
FIRMS_MAP_KEY=           # the Eye: NASA FIRMS active fires (free)
AISSTREAM_API_KEY=       # the Eye: live vessels (free)

# ── AXIOM's ears: local Whisper (whisper.cpp, MIT weights) ──
# .venv/bin/pip install pywhispercpp && brew install ffmpeg
# curl -L -o .data/whisper/ggml-base.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# .venv/bin/python signals/stt_server.py     (launchd: com.polymarket.stt, :5002)
WHISPER_MODEL=            # default .data/whisper/ggml-base.en.bin; small.en is more accurate, slower
STT_URL=                  # default http://127.0.0.1:5002
# AXIOM's ears — ggml-base.en.bin is the default: 147 ms and it hears the desk's
# vocabulary. ggml-small.en.bin halves the word error but costs ~1.3 s a sentence,
# which is most of a conversation's rhythm. Both live in .data/whisper/.
# WHISPER_MODEL=/Users/saiyaganti/polymarket-hft/.data/whisper/ggml-small.en.bin
