# ── Polymarket live account (set via /settings UI) ────────────────────────────
POLYMARKET_PRIVATE_KEY=       # wallet private key (Settings→Export on polymarket.com)
POLYMARKET_FUNDER=            # your Polymarket proxy/deposit address (0x...)
POLYMARKET_SIGNATURE_TYPE=1   # 1=email/Magic proxy, 0=EOA/MetaMask, 2=browser-wallet
# ── Trading mode (MANUAL two-step to go live) ─────────────────────────────────
DRY_RUN=true                  # true=no real orders. Flip to false ONLY when a strategy is ROBUST.
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=150
# ── Micro-live risk stack (edit at /live-account) ─────────────────────────────
LIVE_MICRO_USD=1              # stake per live order (hard ceiling $5)
LIVE_DAILY_CAP_USD=10
LIVE_DAILY_PROFIT_TARGET=5    # auto-stop after +$X profit (anti-overtrade)
LIVE_STOP_LOSS_USD=5          # auto-stop after -$X loss
# ── Per-bot master switches (edit at /settings) ───────────────────────────────
BOT_CRYPTO_ENABLED=true
BOT_ORACLELAG_ENABLED=true
BOT_WEATHER_ENABLED=true
BOT_KRONOS1H_ENABLED=true
BOT_PREMARKET_ENABLED=true
BOT_OPTIONS_ENABLED=true
# ── LLM (also in frontend/.env.local) ─────────────────────────────────────────
GROQ_API_KEY=                 # fast, free: console.groq.com  (primary)
NVIDIA_API_KEY=               # fallback
HF_TOKEN=                     # HuggingFace, for Kronos weight downloads
# ── Infra ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://trading:trading@localhost:5432/polymarket_hft
